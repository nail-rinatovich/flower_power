# Reference only: Django reads environment variables, not this file automatically.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=your-service.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com
DJANGO_DB_PATH=/var/data/db.sqlite3
DJANGO_MEDIA_ROOT=/var/data/media
